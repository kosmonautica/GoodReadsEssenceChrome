{
  "manifest_version": 3,
  "name": "GoodReads Essence",
  "version": "0.1.0",
  "description": "Turns a Goodreads book page into a Markdown note, ready to paste into Obsidian.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://www.goodreads.com/*"],
  "action": {
    "default_title": "GoodReads Essence",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
